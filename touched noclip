local player = game.Players.LocalPlayer
local runService = game:GetService("RunService")

local function createGui()
    local oldGui = player.PlayerGui:FindFirstChild("SuperStatsGui")
    if oldGui then oldGui:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = "SuperStatsGui"
    sg.ResetOnSpawn = false
    sg.Parent = player:WaitForChild("PlayerGui")

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 120, 0, 40)
    btn.Position = UDim2.new(0, 50, 0.5, 0)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = "BOOST: OFF"
    btn.Font = Enum.Font.Montserrat
    btn.TextScaled = true
    btn.Draggable = true
    btn.Parent = sg
    
    local active = false

    btn.MouseButton1Click:Connect(function()
        active = not active
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if active then
            btn.Text = "Misha Gey"
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        else
            btn.Text = "Misha ne Gey"
            btn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
            -- Сброс к стандартам
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
                hum.JumpHeight = 7.2
            end
            if char then
                for _, p in pairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CanTouch = true
                        p.CanQuery = true
                    end
                end
            end
        end
    end)

    -- Постоянный цикл для скорости, прыжка и Ghost Mode
    runService.Stepped:Connect(function()
        if active and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 300 -- Скорость 300
                hum.JumpPower = 50  -- Сила прыжка 50
                hum.JumpHeight = 50 -- На всякий случай для новых игр
            end

            -- Ghost Mode (чтобы не умирать на бегу от ловушек)
            for _, p in pairs(player.Character:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanTouch = false
                    p.CanQuery = false
                    -- CanCollide НЕ трогаем, чтобы ты не провалился на такой скорости
                end
            end
        end
    end)
end

createGui()
