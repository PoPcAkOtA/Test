local player = game.Players.LocalPlayer
local mouse = player:GetMouse() -- Получаем мышку
local runService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local function createGui()
    local oldGui = player.PlayerGui:FindFirstChild("GhostModeGui")
    if oldGui then oldGui:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = "GhostModeGui"
    sg.ResetOnSpawn = false
    sg.Parent = player:WaitForChild("PlayerGui")

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 120, 0, 40)
    btn.Position = UDim2.new(0, 50, 0.5, 0)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = "OFF"
    btn.BorderSizePixel = 2
    btn.Parent = sg
    btn.Font = Enum.Font.Montserrat
    btn.TextScaled = true
    btn.Draggable = true 
    
    local active = false

    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.Text = "ON"
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        else
            btn.Text = "OFF"
            btn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
            
            if player.Character then
                local ff = player.Character:FindFirstChild("GhostFF")
                if ff then ff:Destroy() end
                
                for _, p in pairs(player.Character:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CanTouch = true
                        p.CanQuery = true
                        p.CanCollide = true
                    end
                end
            end
        end
    end)

    -- Телепорт на позицию мышки при нажатии E
    UIS.InputBegan:Connect(function(input, gpe)
        if not gpe and active and input.KeyCode == Enum.KeyCode.Q then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                -- Устанавливаем позицию в точку, куда указывает мышка + небольшой подъем вверх (3 студа)
                root.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
            end
        end
    end)

    runService.Stepped:Connect(function()
        if active and player.Character then
            -- ForceField
            if not player.Character:FindFirstChild("GhostFF") then
                local ff = Instance.new("ForceField")
                ff.Name = "GhostFF"
                ff.Visible = false
                ff.Parent = player.Character
            end

            -- Ghost Mode / NoClip
            for _, p in pairs(player.Character:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanTouch = false
                    p.CanQuery = false
                    p.CanCollide = false
                end
            end
        end
    end)
end

createGui()
